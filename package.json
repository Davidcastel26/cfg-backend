{
  "name": "cfg-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "sequelize": "tsx ./node_modules/sequelize-cli/lib/sequelize",
    "db:migrate": "npm run sequelize -- db:migrate",
    "db:migrate:undo": "npm run sequelize -- db:migrate:undo",
    "db:migrate:undo:all": "npm run sequelize -- db:migrate:undo:all",
    "db:seed": "npm run sequelize -- db:seed:all",
    "db:seed:undo": "npm run sequelize -- db:seed:undo:all",
    "seed": "npm run db:seed",
    "import:excel": "tsx src/importExcel.ts",
    "openapi:generate": "tsx src/openapiGen.ts",
    "test:openapi": "npm run openapi:generate && redocly lint openapi.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.31.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.4.0",
    "eslint-plugin-no-restricted-imports": "^0.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
